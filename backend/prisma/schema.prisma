generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String     @id @default(uuid()) @db.Uuid
  firstname     String     @db.VarChar(255)
  lastname      String     @db.VarChar(255)
  name          String     @db.VarChar(255)
  email         String     @unique @db.VarChar(255)
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?    @db.VarChar(255)
  role          UserRole
  title         String?    @db.VarChar(255)
  sector        String?    @db.VarChar(255)
  location      String?    @db.VarChar(255)
  availability  String?    @db.VarChar(255)
  organization  String?    @db.VarChar(255)
  profileHidden Boolean    @default(false) @map("profile_hidden")
  skills        String[]   @default([])
  certified     Boolean    @default(false)
  cguAcceptedAt DateTime?  @map("cgu_accepted_at") @db.Timestamptz(3)
  cguVersion    String?    @map("cgu_version") @db.VarChar(50)
  createdAt     DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @map("updated_at") @db.Timestamptz(3)
  birthdate     DateTime   @db.Timestamp(0)

  answers       Answers[]
  favoritesGiven    Favorites[] @relation("RecruiterFavorites")
  favoritesReceived Favorites[] @relation("FavoritedAsJobseeker")
  surveys       Surveys[]
  videos        Videos?
  sessions      Session[]
  accounts      Account[]

  notificationsReceived Notifications[] @relation("NotificationRecipient")
  notificationsSent     Notifications[] @relation("NotificationActor")

  @@map("users")
}

model Surveys {
  id                String    @id @default(uuid()) @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  date              DateTime  @db.Timestamp(0)
  questionnaireFile String    @map("questionnaire_file") @db.VarChar(255)
  answers           Answers[]
  users             Users     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("surveys")
}

model Answers {
  id         String   @id @default(uuid()) @db.Uuid
  surveyId   String   @map("survey_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  value      String   @db.VarChar(255)
  survey     Surveys  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@map("answers")
}

model Videos {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @map("user_id") @db.Uuid
  providerName String      @map("provider_name") @db.VarChar(32)
  providerId   String      @map("provider_id") @db.VarChar(255)
  status       VideoStatus @default(PROCESSING)
  size         Int?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         Users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerName, providerId])
  @@map("videos")
}

model Favorites {
  favoritedUserId String   @map("favorited_user_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  favoritedUser Users @relation("FavoritedAsJobseeker", fields: [favoritedUserId], references: [id], onDelete: Cascade)
  recruiter     Users @relation("RecruiterFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@id([favoritedUserId, userId])
  @@index([userId])
  @@map("favorites")
}

model Notifications {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  payload     Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)

  recipient   Users            @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       Users?           @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id") @db.Uuid
  user                   Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                 String
  accountId              String    @map("account_id")
  providerId             String    @map("provider_id")
  accessToken            String?   @map("access_token")
  refreshToken           String?   @map("refresh_token")
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                  String?
  idToken                String?   @map("id_token")
  password               String?
  createdAt              DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

enum VideoStatus {
  PROCESSING
  READY
  ERROR

  @@map("video_status")
}

enum UserRole {
  jobseeker
  recruiter
  admin

  @@map("user_role")
}

enum NotificationType {
  FAVORITE_ADDED
  PROFILE_VIEWED

  @@map("notification_type")
}