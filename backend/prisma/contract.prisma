// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Users {
    id            Uuid              @id(map: "users_pkey")
    firstname     VarChar(255)
    lastname      VarChar(255)
    name          VarChar(255)
    email         VarChar(255)      @unique(map: "users_email_key")
    emailVerified Boolean           @default(false) @map("email_verified")
    image         VarChar(255)?
    role          pg.enum(UserRole)
    createdAt     Timestamptz(3)    @map("created_at")
    updatedAt     Timestamptz(3)    @map("updated_at")
    birthdate     Timestamp(0)
    answers       Answers[]
    favorites     Favorites[]
    likes         Likes[]
    surveys       Surveys[]
    videos        Videos?
    sessions      Session[]
    accounts      Account[]

    @@map("users")
  }

  model Surveys {
    id          Uuid          @id(map: "surveys_pkey")
    createdBy   Uuid          @map("created_by")
    date        Timestamp(0)
    title       VarChar(255)
    description VarChar(255)?
    questions   Questions[]
    users       Users         @relation(fields: [createdBy], references: [id], onDelete: Restrict, map: "surveys_created_by_fkey", index: false)

    @@map("surveys")
  }

  model Questions {
    id       Uuid         @id(map: "questions_pkey")
    surveyId Uuid         @map("survey_id")
    label    VarChar(255)
    answers  Answers[]
    options  Options[]
    survey   Surveys      @relation(fields: [surveyId], references: [id], onDelete: Cascade, map: "questions_survey_id_fkey", index: false)

    @@map("questions")
  }

  model Options {
    id         Uuid         @id(map: "options_pkey")
    questionId Uuid         @map("question_id")
    option     VarChar(255)
    answers    Answers[]
    question   Questions    @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "options_question_id_fkey", index: false)

    @@map("options")
  }

  model Answers {
    id         Uuid      @id(map: "answers_pkey")
    questionId Uuid      @map("question_id")
    userId     Uuid      @map("user_id")
    optionId   Uuid      @map("option_id")
    option     Options   @relation(fields: [optionId], references: [id], onDelete: Cascade, map: "answers_option_id_fkey", index: false)
    question   Questions @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "answers_question_id_fkey", index: false)
    user       Users     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "answers_user_id_fkey", index: false)

    @@unique([questionId, userId], map: "answers_question_id_user_id_key")
    @@map("answers")
  }

  model Videos {
    id        Uuid         @id(map: "videos_pkey")
    userId    Uuid         @unique(map: "videos_user_id_key") @map("user_id")
    videoLink VarChar(255) @map("video_link")
    favorites Favorites[]
    likes     Likes[]
    user      Users        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "videos_user_id_fkey")

    @@map("videos")
  }

  model Favorites {
    videoId Uuid   @map("video_id")
    userId  Uuid   @map("user_id")
    user    Users  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "favorites_user_id_fkey", index: false)
    video   Videos @relation(fields: [videoId], references: [id], onDelete: Cascade, map: "favorites_video_id_fkey", index: false)

    @@id([videoId, userId], map: "favorites_pkey")
    @@map("favorites")
  }

  model Likes {
    videoId Uuid   @map("video_id")
    userId  Uuid   @map("user_id")
    user    Users  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "likes_user_id_fkey", index: false)
    video   Videos @relation(fields: [videoId], references: [id], onDelete: Cascade, map: "likes_video_id_fkey", index: false)

    @@id([videoId, userId], map: "likes_pkey")
    @@map("likes")
  }

  model Session {
    id        VarChar(255)   @id(map: "session_pkey")
    userId    Uuid           @map("user_id")
    user      Users          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_user_id_fkey", index: false)
    token     VarChar(255)   @unique(map: "session_token_key")
    expiresAt Timestamptz(3) @map("expires_at")
    ipAddress VarChar(255)?  @map("ip_address")
    userAgent VarChar(255)?  @map("user_agent")
    createdAt Timestamptz(3) @map("created_at")
    updatedAt Timestamptz(3) @map("updated_at")

    @@index([userId], map: "session_userId_idx")
    @@map("session")
  }

  model Account {
    id                    VarChar(255)    @id(map: "account_pkey")
    userId                Uuid            @map("user_id")
    user                  Users           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_user_id_fkey", index: false)
    issuer                VarChar(255)
    accountId             VarChar(255)    @map("account_id")
    providerId            VarChar(255)    @map("provider_id")
    accessToken           VarChar(500)?   @map("access_token")
    refreshToken          VarChar(500)?   @map("refresh_token")
    accessTokenExpiresAt  Timestamptz(3)? @map("access_token_expires_at")
    refreshTokenExpiresAt Timestamptz(3)? @map("refresh_token_expires_at")
    scope                 VarChar(255)?
    idToken               VarChar(500)?   @map("id_token")
    password              VarChar(255)?
    createdAt             Timestamptz(3)  @map("created_at")
    updatedAt             Timestamptz(3)  @map("updated_at")

    @@index([userId], map: "account_userId_idx")
    @@map("account")
  }

  model Verification {
    id         VarChar(255)   @id(map: "verification_pkey")
    identifier VarChar(255)
    value      VarChar(500)
    expiresAt  Timestamptz(3) @map("expires_at")
    createdAt  Timestamptz(3) @map("created_at")
    updatedAt  Timestamptz(3) @map("updated_at")

    @@index([identifier], map: "verification_identifier_idx")
    @@map("verification")
  }

  native_enum UserRole {
    jobseeker = "jobseeker"
    recruiter = "recruiter"
    admin = "admin"
    @@map("user_role")
  }
}